<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Receipt form: Read labels button and Parse photos tab -->
    <record id="view_picking_form_parse" model="ir.ui.view">
        <field name="name">stock.picking.form.parse</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm']" position="before">
                <button name="action_parse_upload" type="object" string="Read labels"
                        invisible="picking_type_code != 'incoming' or state in ('done', 'cancel')"
                        groups="stock.group_stock_user"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Parse photos" name="parse_photos" invisible="picking_type_code != 'incoming'">
                    <field name="parse_photo_ids" readonly="1">
                        <!-- yellow row when the photo has a warning -->
                        <list decoration-warning="warning">
                            <field name="name"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'to_read'"
                                   decoration-success="state == 'done'"
                                   decoration-danger="state == 'error'"/>
                            <field name="product_id"/>
                            <field name="supplier_id"/>
                            <field name="label_text"/>
                            <field name="confidence" widget="percentage" invisible="state != 'done'"/>
                            <field name="warning"/>
                            <field name="error_message"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
